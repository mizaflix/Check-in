# Banco de dados e segurança
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_BANCO
SECRET_KEY=gere-uma-chave-segura

# Senha inicial usada somente ao criar professor/auxiliar pelo painel admin.
# Escolha uma senha forte (mínimo de 8 caracteres); será exigida troca no primeiro acesso.
SENHA_PADRAO_PROFESSOR=12345678

# Contas fictícias de teste ficam desativadas por padrão.
CRIAR_USUARIOS_TESTE=false

# Fotos: armazenamento local em static/uploads por padrão.
# Em VPS, configure um diretório persistente se desejar outro caminho.
# UPLOAD_FOLDER=/opt/checkkids/static/uploads

# WhatsApp via Evolution API
# URL base da sua instância (ex: https://evolution.seudominio.com)
EVOLUTION_API_URL=https://evo.ipjardim.com.br/
# API Key global ou da instância (aba API Keys no painel da Evolution)
EVOLUTION_API_KEY=senha_forte_demais_para_ser_verdade
# Nome da instância criada no painel da Evolution API
EVOLUTION_INSTANCE=351911041672
