# Banco de dados e segurança
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_BANCO
SECRET_KEY=gere-uma-chave-segura

# Fotos: Cloudinary (recomendado para Render)
# Copie o valor completo em Cloudinary Console > Settings > API Keys.
CLOUDINARY_URL=

# Alternativa: conecte Persistent Disk no Render com mount path /var/data
# e configure a variável abaixo para o diretório dentro do disco.
# UPLOAD_FOLDER=/var/data/uploads

# WhatsApp/Twilio - variáveis usadas pela integração presente nesta versão
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=
