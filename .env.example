# ─────────────────────────────────────────────────────────────────────────────
# Aplicação (CheckKids)
# ─────────────────────────────────────────────────────────────────────────────
SECRET_KEY=troque_por_uma_chave_secreta_forte
UPLOAD_FOLDER=/app/static/uploads

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=checkkids
POSTGRES_PASSWORD=troque_por_uma_senha_forte_do_banco
POSTGRES_DB=checkkids
EVOLUTION_DB_NAME=evolution

# Opcional: caso queira sobrescrever a URL montada automaticamente pelo compose
# DATABASE_URL=postgresql://checkkids:troque_por_uma_senha_forte_do_banco@postgres:5432/checkkids

# ─────────────────────────────────────────────────────────────────────────────
# pgAdmin 4
# ─────────────────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@seudominio.com
PGADMIN_DEFAULT_PASSWORD=troque_por_uma_senha_forte_do_pgadmin

# ─────────────────────────────────────────────────────────────────────────────
# Evolution API v2
# ─────────────────────────────────────────────────────────────────────────────
EVOLUTION_API_KEY=troque_por_uma_api_key_forte
EVOLUTION_INSTANCE=checkkids
# URL pública da Evolution API (configurada no seu Nginx Proxy)
EVOLUTION_SERVER_URL=https://evolution.seudominio.com
# Comunicação interna do app com a Evolution pela rede backend (ou use a URL pública)
EVOLUTION_API_URL=http://evolution-api:8080
